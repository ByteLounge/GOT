{
  "name": "govalert",
  "version": "1.0.0",
  "private": true,
  "description": "Government Opportunities & Scholarship Alert Android App & Platform",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:mobile": "npm --prefix apps/mobile start",
    "dev:admin": "npm --prefix apps/admin run dev",
    "build:packages": "npm --prefix packages/types run build && npm --prefix packages/validation run build && npm --prefix packages/shared run build",
    "build:backend": "npm --prefix backend run build",
    "build:admin": "npm --prefix apps/admin run build",
    "build:apk": "powershell -ExecutionPolicy Bypass -File ./scripts/build-android-apk.ps1",
    "test:backend": "npm --prefix backend test"
  },
  "keywords": [
    "government-jobs",
    "scholarships",
    "react-native",
    "android",
    "expo",
    "nodejs",
    "typescript"
  ],
  "author": "GovAlert Team",
  "license": "MIT"
}
