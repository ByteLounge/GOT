# GovAlert Environment Configuration Template

# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# JWT Authentication
JWT_SECRET=super_secret_govalert_jwt_key_replace_in_production
JWT_EXPIRES_IN=7d

# Database Configuration (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/govalert?schema=public

# Supabase (Optional, if using Supabase client)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Configuration (Optional, cost-controlled document extraction)
AI_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here

# Push Notifications (Expo Push Service / FCM)
EXPO_ACCESS_TOKEN=your_expo_access_token_if_configured

# Admin System
ADMIN_EMAIL=admin@govalert.in
ADMIN_INITIAL_PASSWORD=GovAdmin@2026

# Ingestion Worker Settings
ENABLE_INGESTION_CRON=true
INGESTION_CRON_SCHEDULE="0 */6 * * *"
